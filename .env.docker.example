ENVIRONMENT=docker
LOG_LEVEL=INFO
DATABASE_URL=postgresql://fkip:fkip@postgres:5432/financial_intelligence
OBJECT_STORE_PATH=data/documents
VECTOR_INDEX_PATH=data/index/vector_index.json
