ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///data/metadata.db
OBJECT_STORE_PATH=data/documents
VECTOR_INDEX_PATH=data/index/vector_index.json
VECTOR_STORE_BACKEND=local
QDRANT_URL=http://localhost:6333
QDRANT_DOCUMENT_COLLECTION=fkip_documents
QDRANT_CHUNK_COLLECTION=fkip_document_chunks
EMBEDDING_DIMENSIONS=256
PIPELINE_METRICS_PATH=data/metrics/latest_ingestion.json
LLM_PROVIDER=extractive
OPENAI_MODEL=gpt-5-mini
